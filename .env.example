# Local development only. These example database credentials never point at production.
NODE_ENV=development
DATABASE_URL=postgresql://recollect:recollect@127.0.0.1:5432/recollect
PORT=3001
HOST=127.0.0.1
# Generate a unique value: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ACCESS_TOKEN_SECRET=
APPLE_BUNDLE_ID=collect.software.cognition-curator
ENABLE_DEV_AUTH=false
DAILY_GENERATION_CARDS=100
ANTHROPIC_API_KEY=
# Set an available Anthropic model explicitly before starting the worker.
ANTHROPIC_MODEL=
# Explicitly required only for the reviewed migration command, never automatic on API startup.
CONFIRM_DATABASE_MIGRATION=no
CONFIRM_QUEUE_SETUP=no
CONFIRM_LEGACY_READ_ONLY=no
