# Local mobile configuration. Real values belong in the ignored .env.local file.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_ENABLE_DEV_AUTH=false
EXPO_PUBLIC_POSTHOG_PROJECT_TOKEN=
EXPO_PUBLIC_POSTHOG_HOST=
# Development analytics is off unless explicitly enabled against a test project.
# Recording still requires the signed-in user's in-app permission.
EXPO_PUBLIC_POSTHOG_ENABLE_DEV=false
