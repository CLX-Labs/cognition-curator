{
  "name": "@recollect/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test",
    "export:ios": "expo export --platform ios",
    "build:development": "npm exec --yes --package=eas-cli@24.12.1 -- eas build --platform ios --profile development",
    "build:preview": "npm exec --yes --package=eas-cli@24.12.1 -- eas build --platform ios --profile preview",
    "build:production": "npm exec --yes --package=eas-cli@24.12.1 -- eas build --platform ios --profile production"
  },
  "dependencies": {
    "@recollect/contracts": "*",
    "@recollect/scheduler": "*",
    "expo": "57.0.27",
    "expo-apple-authentication": "~57.0.2",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.12",
    "expo-modules-core": "~57.0.21",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.25",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3"
  }
}
