{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "jsx": "react-jsx",
    "types": ["react", "node"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": [
    "app/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "modules/**/*.ts",
    "app.config.ts",
    "expo-env.d.ts"
  ],
  "exclude": ["test", "node_modules"]
}
